# Copy to .env next to docker-compose.yml and adjust.

# Passwords (empty = open access; set them before exposing FAVA outside home)
FAVA_PASSWORD=
FAVA_ADMIN_PASSWORD=

# This server's LAN address as seen by phones / Chromecast
FAVA_PUBLIC_URL=http://192.168.1.10:8080

# NAS user/group that owns the data folder (run `id` on the NAS)
PUID=1000
PGID=1000

# Where things live on the NAS (relative to this folder or absolute paths)
FAVA_ASSET_PATH=./asset
FAVA_DATA_PATH=./data

# Ports
FAVA_PORT=8080
FAVA_HTTPS_PORT=8443

TZ=Europe/Rome
