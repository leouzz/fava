# Copy to .env and adjust; docker compose reads it automatically.

# Family password: needed to open the app (empty = no password)
FAVA_PASSWORD=
# Parents' password: import, uploads, profile management, cover review (optional)
FAVA_ADMIN_PASSWORD=

# Address of this server on your LAN, used by the Chromecast to fetch audio
FAVA_PUBLIC_URL=http://192.168.1.10:8080

# auto | always | never
FAVA_IMPORT_ON_START=auto
